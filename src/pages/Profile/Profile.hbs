<main class="profile">
  <aside class="profile__back">
    {{{LinkUI
      href="/messenger"
      text="←"
      class="profile__back-link"
    }}}
  </aside>

  <section class="profile__info">
    {{{Avatar class="profile__avatar"}}}

    <h1 class="profile__name">{{displayName}}</h1>

    <ul class="profile__fields">
      {{#each fields}}
        <li class="profile__field">
          <span class="profile__field-label">{{label}}</span>
          <span class="profile__field-value">{{value}}</span>
        </li>
      {{/each}}
    </ul>

    <nav class="profile__actions">
      {{{LinkUI
        href="/profile-edit"
        text="Изменить данные"
        class="profile__link"
      }}}
      {{{LinkUI
        href="/profile-password"
        text="Изменить пароль"
        class="profile__link"
      }}}
      {{{LinkUI
        href="/"
        text="Выйти"
        class="profile__link profile__link_danger"
      }}}
    </nav>
  </section>
</main>
