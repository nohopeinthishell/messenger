<main class="profile">
  <aside class="profile__back">
    {{{LinkUI href="/settings" text="←" class="profile__back-link"}}}
  </aside>

  <section class="profile__info">
    {{{Avatar
      class="profile__avatar profile__avatar_margin"
      src=user.avatar
      action="avatar-open"
    }}}

    {{{FormProfile fields=fields button=button formType="profile"}}}
  </section>

  {{{Modal
    isOpen=isAvatarModalOpen
    content=modalContent
  }}}
</main>
