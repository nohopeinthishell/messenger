<section class="card {{class}}">
  <h1 class="card__title">{{title}}</h1>
  <form class="card__form">
    <div class="card__content">
    {{#each inputs}}
      {{> InputUI
        label=label
        type=type
        name=name
        value=value
        placeholder=placeholder
        autocomplete=autocomplete
        error=error
      }}
    {{/each}}
    </div>
    <div class="card__btns">
      {{#if button}}
        {{> ButtonUI
          text=button.text
          type=button.type
          action=button.action
          class=button.class
        }}
      {{/if}}
      {{#each links}}
        {{> LinkUI href=href page=page text=text class=class}}
      {{/each}}
    </div>
  </form>
</section>
