<form class="form-auth">
  <div class="form-auth__content">
    {{#each inputs}}
      {{{InputUI
        label=label
        type=type
        name=name
        value=value
        placeholder=placeholder
        autocomplete=autocomplete
        error=error
      }}}
    {{/each}}
  </div>
  <div class="form-auth__btns">
    {{#if button}}
      {{{ButtonUI
        text=button.text
        type=button.type
        page=button.page
        class=button.class
      }}}
    {{/if}}
    {{#each links}}
      {{{LinkUI href=href text=text class=class}}}
    {{/each}}
  </div>
</form>
