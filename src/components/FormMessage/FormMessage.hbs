<form class="chat__form">
  {{{InputUI
    type=input.type
    name=input.name
    value=input.value
    placeholder=input.placeholder
    autocomplete=input.autocomplete
    error=input.error
    class=input.class
  }}}
  <button
    class="{{button.class}}"
    type="{{button.type}}"
    data-action="{{button.action}}"
    page="{{button.page}}"
    aria-label="{{button.ariaLabel}}"
  >
    {{button.text}}
  </button>
</form>
