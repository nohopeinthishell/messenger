{
  "name": "messenger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 3000",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint --fix \"src/**/*.css\"",
    "lint": "npm run lint:types && npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:types": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/handlebars": "^4.0.40",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "handlebars": "^4.7.9"
  }
}
